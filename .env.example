VAULTEX_PATH=/path/to/vaultex
MCP_AUTH_TOKEN=
EXCLUDED_AREAS=
READ_ONLY=false

# Registers move_note (move/rename a note within the vault). Gated
# separately from, on top of, READ_ONLY: off by default even in read/write
# mode, since relocate-and-possibly-overwrite is riskier than an additive
# write. Opt in only once you trust the client with it.
ENABLE_NOTE_MOVE=false

# Registers apply_distillation, which writes a distilled proposal (new
# decisions / open questions, with provenance) into the durable store and
# marks the source session promoted. Same gating rationale as
# ENABLE_NOTE_MOVE; distill_session (read-only bundling) needs no flag.
ENABLE_DISTILL_APPLY=false

# Requests allowed per source IP per RATE_LIMIT_WINDOW_SECONDS (sliding
# window), applied ahead of auth. Defaults shown are sane for a single-user
# server; raise them if you hit 429s during normal use.
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Auto-link brand-new notes to close semantic matches with a "## Related
# notes" section (never on edits to existing notes). No-op either way until
# a semantic index exists — see "Semantic search (optional)" in README.
AUTO_LINK_ON_SAVE=true

# Log every `search` call (query, params, fused top results) to a
# search_events table in vault_embeddings.db — raw material for a future
# Learning-to-Rank ranker. Best-effort, off by default; nothing reads the
# table yet, and a logging failure never breaks search.
SEARCH_LOG=false

# Remote access (optional) — set these two together only when running via
# docker-compose.yml with the bundled Tailscale sidecar. Leave both unset for
# plain local/dev use: no OAuth routes are registered at all, and this file
# behaves exactly as it did before.
OAUTH_ISSUER_URL=
AUTHORIZE_PASSWORD=

# Hosts allowed as an OAuth client's redirect_uri (comma-separated).
# Dynamic client registration is unauthenticated by spec, so this is what
# stops a random internet client from completing a real OAuth flow.
# Defaults to claude.ai if unset — only add more if you're pointing another
# MCP client at this server.
ALLOWED_REDIRECT_HOSTS=claude.ai

# docker-compose.yml only — your own Tailscale auth key (Tailscale admin
# console). Not read by server.py itself.
# from your own Tailscale account. Go to Tailscale admin console → Keys → "Generate auth key".s
TS_AUTHKEY=
